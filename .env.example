# Shopify developer dashboard authentication
SHOPIFY_ADMIN_USERNAME=
SHOPIFY_ADMIN_PASSWORD=
SHOPIFY_DEV_DASHBOARD_URL=https://dev.shopify.com/dashboard/231999280/stores

# Optional selectors used to identify the intended development store/app.
# Keep account/store-specific values local if they should not be published.
SHOPIFY_DEV_STORE_NAME=
SHOPIFY_APP_NAME=Moda Interact

# Merchant YouTube demo capture. These are navigation URLs/labels, not secrets.
# SHOPIFY_STORE_ADMIN_URL is the store root shown in the browser before the app opens.
# SHOPIFY_MERCHANT_APP_URL is the installed app URL in Shopify Admin after opening Moda Interact.
SHOPIFY_STORE_ADMIN_URL=https://admin.shopify.com/store/<development-store-handle>
SHOPIFY_MERCHANT_APP_URL=https://admin.shopify.com/store/<development-store-handle>/apps/<installed-app-handle>
SHOPIFY_APP_NAV_LABEL=moda-interact

# Main ACTIVE-store walkthrough fixture. Use synthetic demo data only.
# The configured recovery must resolve to an @example.invalid customer before
# Recovery Detail is recorded.
SHOPIFY_DEMO_RECOVERY_CUSTOMER=Ada Lovelace
# Optional exact visible Shopify discount used only as unsaved local form state.
SHOPIFY_DEMO_FIXED_DISCOUNT_LABEL=
# Unsaved no-response follow-up example shown in Recovery Settings.
SHOPIFY_DEMO_FOLLOW_UP_MINUTES=120
# Merchant Knowledge purpose selected locally in the read-only demo forms.
SHOPIFY_DEMO_KNOWLEDGE_PURPOSE=Pricing

# One-shot merchant onboarding video (fresh development store only).
# The Free plan name defaults to "Free". Set the exact visible Shopify plan/action
# labels only when your Partner Dashboard pricing content uses different wording.
# Shopify development stores commonly show 'Test with this plan' followed by an
# 'Approve' confirmation screen; both are detected automatically.
SHOPIFY_ONBOARDING_FREE_PLAN_NAME=Free
SHOPIFY_ONBOARDING_STORE_CATEGORY=
# Optional exact item-type checkbox labels for the selected category, separated by |.
# Example: Clothing Accessories|Handbag & Wallet Accessories
SHOPIFY_ONBOARDING_STORE_ITEM_TYPES=
SHOPIFY_ONBOARDING_CHOOSE_PLAN_LABEL=View plans in Shopify
SHOPIFY_ONBOARDING_PLAN_ACTION_LABEL=
SHOPIFY_ONBOARDING_CONFIRM_LABEL=

# Moda Interact Admin test environment.
# The value below is exactly the URL supplied when this repository was designed.
# Override locally if the intended host differs.
MODA_ADMIN_BASE_URL=https://admi-test.modainteract.com

# Admin currently authenticates through Google OAuth.
# Prefer reusable Playwright storage state after an interactive/headed login.
MODA_ADMIN_GOOGLE_USERNAME=
MODA_ADMIN_GOOGLE_PASSWORD=

# Optional path overrides. Defaults should live under playwright/.auth/.
SHOPIFY_STORAGE_STATE_PATH=playwright/.auth/shopify.json
MODA_ADMIN_STORAGE_STATE_PATH=playwright/.auth/moda-admin.json

# Capture controls
CAPTURE_DEFAULT_LOCALE=en
CAPTURE_HEADLESS=true

# VIDEO-002 local AI narration. Kokoro runs locally and needs no API key.
VOICEOVER_PROVIDER=kokoro
VOICEOVER_VOICE=bf_emma
VOICEOVER_LANGUAGE=en-gb
VOICEOVER_SPEED=1.08
# Optional explicit source clip. When blank, the renderer prefers .final.webm,
# then .edited.webm, then the raw onboarding capture.
VIDEO_ONBOARDING_SOURCE=
# Optional Python 3.10-3.13 override used only by scripts/setup-kokoro.sh.
KOKORO_PYTHON=
