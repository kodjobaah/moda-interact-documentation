\newcommand{\ModaRule}{\par\noindent\textcolor{ModaGreen}{\rule{\linewidth}{1.2pt}}\par}

\newcommand{\ModaMakeTitle}{%
  \begin{titlepage}
    \vspace*{18mm}
    {\Large\bfseries\color{ModaGreen} MODA INTERACT\par}
    \vspace{6mm}
    {\Huge\bfseries\color{ModaDark}\ManualTitle\par}
    \vspace{3mm}
    {\Large\color{ModaGrey}\ManualSubtitle\par}
    \vspace{10mm}
    \ModaRule
    \vspace{8mm}
    \begin{tabular}{@{}>{\bfseries}p{0.26\linewidth}p{0.66\linewidth}@{}}
      Audience & \ManualAudience\\[4pt]
      Version & \ManualVersion\\[4pt]
      Status & \ManualStatus\\[4pt]
      Source review & \ManualSourceReview\\[4pt]
      Manual locale & \ManualLocale\\
    \end{tabular}
    \vfill
    {\small\color{ModaGrey}\ManualFrontNote\par}
  \end{titlepage}
}

\newcommand{\ModaCallout}[3]{%
  \begin{center}
  \fcolorbox{#1}{#2}{\begin{minipage}{0.92\linewidth}\textbf{#3}\end{minipage}}
  \end{center}
}
\newcommand{\ModaNote}[1]{\ModaCallout{ModaGreen}{ModaLightGreen}{#1}}
\newcommand{\ModaWarning}[1]{\ModaCallout{ModaAmber}{ModaAmberBg}{#1}}
\newcommand{\ModaCritical}[1]{\ModaCallout{ModaRed}{ModaRedBg}{#1}}
\newcommand{\ModaCurrentState}[1]{\ModaCallout{ModaGrey}{ModaLightGrey}{\textbf{Current implementation note.} #1}}

\newcommand{\ModaScreenshot}[2]{%
  \begin{figure}[htbp]
  \centering
  \IfFileExists{#1.\ManualLocale.png}{%
    \includegraphics[width=\linewidth,height=0.60\textheight,keepaspectratio]{#1.\ManualLocale.png}%
  }{\IfFileExists{#1.\ManualLocale.jpg}{%
    \includegraphics[width=\linewidth,height=0.60\textheight,keepaspectratio]{#1.\ManualLocale.jpg}%
  }{\IfFileExists{#1.\ManualLocale.jpeg}{%
    \includegraphics[width=\linewidth,height=0.60\textheight,keepaspectratio]{#1.\ManualLocale.jpeg}%
  }{\IfFileExists{#1.\ManualLocale.pdf}{%
    \includegraphics[width=\linewidth,height=0.60\textheight,keepaspectratio]{#1.\ManualLocale.pdf}%
  }{%
    \fbox{\begin{minipage}[c][0.27\textheight][c]{0.92\linewidth}
      \centering
      \textbf{Localized screenshot placeholder}\\[8pt]
      Place one of the following files beside the main \texttt{.tex} file:\\[5pt]
      \texttt{#1.\ManualLocale.png}\\
      \texttt{#1.\ManualLocale.jpg}\\
      \texttt{#1.\ManualLocale.pdf}\\[8pt]
      Screenshot ID: \texttt{#1}
    \end{minipage}}
  }}}}
  \caption{#2}
  \label{fig:#1}
  \end{figure}
}

\newcommand{\ModaOptionalScreenshot}[2]{%
  \IfFileExists{#1.\ManualLocale.png}{\ModaScreenshot{#1}{#2}}{%
  \IfFileExists{#1.\ManualLocale.jpg}{\ModaScreenshot{#1}{#2}}{%
  \IfFileExists{#1.\ManualLocale.jpeg}{\ModaScreenshot{#1}{#2}}{%
  \IfFileExists{#1.\ManualLocale.pdf}{\ModaScreenshot{#1}{#2}}{}%
  }}}%
}

\newcommand{\ModaField}[2]{\textbf{#1}: #2}
